<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/dashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/dashboardWelcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_welcome"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/budgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/budget_default"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/expensesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expenses_default"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/balanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remaining_default"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <ProgressBar
            android:id="@+id/budgetProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/budgetProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/budget_progress_default"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/addExpenseBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_expense"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/viewExpensesBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_expenses"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/budgetBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/budget"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/savingsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/savings_goals"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/categoriesBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/categories"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/achievementsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/achievements"
            android:textAllCaps="false"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/settingsBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
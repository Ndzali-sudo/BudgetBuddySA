<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allows BudgetBuddy SA to communicate with the REST API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:label="BudgetBuddy SA"
        android:supportsRtl="true"
        android:theme="@style/Theme.BudgetBuddySA">

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".AddExpenseActivity"
            android:exported="false" />

        <activity
            android:name=".ViewExpensesActivity"
            android:exported="false" />

        <activity
            android:name=".CategoriesActivity"
            android:exported="false" />

        <activity
            android:name=".BudgetActivity"
            android:exported="false" />

        <activity
            android:name=".SavingsActivity"
            android:exported="false" />

        <activity
            android:name=".AchievementsActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>